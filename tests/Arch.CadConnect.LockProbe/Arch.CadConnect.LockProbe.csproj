<Project Sdk="Microsoft.NET.Sdk">

  <!--
    P6 M4.4 test helper: a separate PROCESS that takes the real Core locks,
    so the lock tests prove Windows handle semantics, crash release and
    alias resolution across processes - not just inside one.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Arch.CadConnect.Core\Arch.CadConnect.Core.csproj" />
    <!-- P6 M4.4 Package C R10: the production Get Latest, for a child killed mid-reconciliation -->
    <ProjectReference Include="..\..\src\Arch.CadConnect.Api\Arch.CadConnect.Api.csproj" />
  </ItemGroup>

</Project>
