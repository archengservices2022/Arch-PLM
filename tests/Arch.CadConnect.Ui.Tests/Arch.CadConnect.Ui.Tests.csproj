<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UI-level tests for WinForms dialogs of the Inventor add-in, WITHOUT
    Inventor: the dialog source files are compiled in unchanged (linked, not
    copied) so the tests exercise exactly the shipped code. No Inventor
    interop, no server, no file I/O.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- test code: relax the solution-wide doc/style strictness -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Arch.CadConnect.Core\Arch.CadConnect.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Arch.CadConnect.Inventor\Ui\CopyDesignApplyConfirmDialog.cs" Link="Linked\CopyDesignApplyConfirmDialog.cs" />
    <Compile Include="..\..\src\Arch.CadConnect.Inventor\Ui\CopyDesignRecoverConfirmDialog.cs" Link="Linked\CopyDesignRecoverConfirmDialog.cs" />
    <Compile Include="..\..\src\Arch.CadConnect.Inventor\Ui\CopyDesignResumeConfirmDialog.cs" Link="Linked\CopyDesignResumeConfirmDialog.cs" />
    <Compile Include="..\..\src\Arch.CadConnect.Inventor\Ui\ConfirmationPhraseBox.cs" Link="Linked\ConfirmationPhraseBox.cs" />
  </ItemGroup>

</Project>
