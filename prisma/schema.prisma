// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ARCH PLM - CORE ENUMS
// ============================================================

enum UserRole {
  ADMIN
  ENGINEER
  DESIGNER
  REVIEWER
  APPROVER
  VIEWER
}

enum ItemType {
  PART
  ASSEMBLY
  DOCUMENT
}

enum LifecycleState {
  WORKING
  IN_REVIEW
  APPROVED
  RELEASED
  SUPERSEDED
  OBSOLETE
}

// PDM: physical CAD document formats. Engineering revision lifecycle
// (LifecycleState) is deliberately unrelated to CAD file versioning.
enum CadDocumentType {
  IPT
  IAM
  IDW
  DWG
  PDF
  OTHER
}

// PDM: the kind of directional relationship between two CAD documents.
//   COMPONENT          IAM assembly contains/references an IPT or IAM component
//   DRAWING_REFERENCE  IDW/DWG drawing references an IAM/IPT model
//   DERIVED            a CAD document is derived from another CAD document
//   REFERENCE          generic external/reference relationship
//   OTHER              fallback
enum CadDependencyType {
  COMPONENT
  DRAWING_REFERENCE
  DERIVED
  REFERENCE
  OTHER
}

// Checkout lifecycle events recorded durably (P3C-3) - see CadCheckoutEvent.
enum CadCheckoutEventType {
  CHECKED_OUT
  CHECKED_IN
  UNDO_CHECKOUT
  ADMIN_UNLOCK
}

// How a CadDocument came to be pinned into a ReleaseBaseline (P3D-3) - see
// ReleaseBaselineEntry. DIRECT = associated with the ItemRevision via
// ItemRevisionDocument at release time; DEPENDENCY = reached only through the
// outgoing CadDependency closure of a direct document. If a document is both,
// DIRECT wins (there is still exactly one entry per document per baseline).
enum ReleaseBaselineInclusionKind {
  DIRECT
  DEPENDENCY
}

// ============================================================
// ORGANIZATION
// ============================================================

model Organization {
  id   String @id @default(cuid())
  name String
  code String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  customers             Customer[]
  projects              Project[]
  items                 Item[]
  itemRevisions         ItemRevision[]
  cadDocuments          CadDocument[]
  fileVersions          FileVersion[]
  itemRevisionDocuments ItemRevisionDocument[]
  cadDependencies       CadDependency[]
  cadCheckouts          CadCheckout[]
  cadCheckoutEvents     CadCheckoutEvent[]
  releaseBaselines      ReleaseBaseline[]
  releaseBaselineEntries ReleaseBaselineEntry[]
}

// ============================================================
// USER
// ============================================================

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  email        String
  name         String
  passwordHash String?
  lastLoginAt  DateTime?

  role   UserRole @default(ENGINEER)
  active Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdCadDocuments          CadDocument[]
  createdFileVersions          FileVersion[]
  createdItemRevisionDocuments ItemRevisionDocument[]
  createdCadDependencies       CadDependency[]
  createdItemRevisions         ItemRevision[]
  // Documents this user currently holds a server-authoritative checkout on.
  // NOT a "created by" relation - see CadCheckout.
  cadCheckouts CadCheckout[]

  // Checkout history (P3C-3): two DISTINCT relations since a
  // CadCheckoutEvent names both who HELD the checkout and who PERFORMED the
  // release (they differ for ADMIN_UNLOCK) - see CadCheckoutEvent.
  checkoutEventsAsOwner CadCheckoutEvent[] @relation("CadCheckoutEventOwner")
  checkoutEventsAsActor CadCheckoutEvent[] @relation("CadCheckoutEventActor")

  // Frozen release baselines this user created (P3D-1).
  createdReleaseBaselines ReleaseBaseline[]

  // Enables tenant-aware composite foreign keys that reference a user
  // together with their organization.
  @@unique([organizationId, id])
  @@unique([organizationId, email])
  @@index([organizationId])
}

// ============================================================
// CUSTOMER
// ============================================================

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name           String
  customerNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]

  @@unique([organizationId, id])
  @@unique([organizationId, customerNumber])
  @@index([organizationId])
}

// ============================================================
// PROJECT
// ============================================================

model Project {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)

  projectNumber String
  name          String
  description   String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items Item[]

  @@unique([organizationId, id])
  @@unique([organizationId, projectNumber])
  @@index([organizationId])
  @@index([customerId])
}

// ============================================================
// ITEM
//
// Permanent engineering identity.
// Example: 10073-MFD-AS210
// ============================================================

model Item {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  projectId String?
  project   Project? @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict)

  itemNumber  String
  description String
  type        ItemType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisions ItemRevision[]

  @@unique([organizationId, id])
  @@unique([organizationId, itemNumber])
  @@index([organizationId])
  @@index([projectId])
  @@index([itemNumber])
}

// ============================================================
// ITEM REVISION
//
// Item 10073-MFD-AS210
//   Rev A
//   Rev B
//
// Revision != CAD file version
// ============================================================

model ItemRevision {
  id String @id @default(cuid())

  // Denormalized tenant key, consistent with Item / Project / Customer.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  itemId String
  item   Item   @relation(fields: [organizationId, itemId], references: [organizationId, id], onDelete: Cascade)

  revision    String
  description String?

  lifecycle  LifecycleState @default(WORKING)
  releasedAt DateTime?

  // Milestone 3: audit lineage. Set from the authenticated actor on the
  // server, never from the client. Tenant-scoped via composite FKs.
  //
  // NULLABLE on purpose: historical ItemRevision rows created before this
  // milestone have no recoverable creator, and we do NOT fabricate one.
  // Every revision the application creates (createItem, createEngineeringRevision)
  // always sets createdById = actor.userId; a NULL means "pre-lineage".
  createdById String?
  createdBy   User?   @relation(fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)

  // The revision this one was derived from ("Create next revision").
  // Same organization (composite FK) and, enforced in the action, same Item.
  sourceRevisionId String?
  sourceRevision   ItemRevision?  @relation("ItemRevisionLineage", fields: [organizationId, sourceRevisionId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  derivedRevisions ItemRevision[] @relation("ItemRevisionLineage")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // CAD documents are linked through ItemRevisionDocument, not owned directly.
  documentLinks ItemRevisionDocument[]

  // At most one row - see ReleaseBaseline's own doc comment for why a plain
  // optional relation (backed by a unique constraint) is sufficient, exactly
  // like CadDocument.checkout.
  releaseBaseline ReleaseBaseline?

  @@unique([organizationId, id])
  @@unique([itemId, revision])
  @@index([organizationId])
  @@index([itemId])
  @@index([lifecycle])
  @@index([createdById])
  @@index([sourceRevisionId])
}

// ============================================================
// CAD DOCUMENT  (PDM)
//
// A logical CAD document identity, e.g. 10073-MFD-AS210.iam
//
// ITEM != ENGINEERING REVISION != CAD DOCUMENT != FILE VERSION
//
// A CadDocument belongs to the Organization, NOT to a single
// ItemRevision. Its identity (and full file-version history) survives
// across engineering revisions. Association with one or more
// ItemRevisions is expressed through the ItemRevisionDocument link.
//
// Saving a newer CAD file adds a FileVersion; it never touches
// ItemRevision.revision or ItemRevision.lifecycle and never creates
// an ItemRevision.
//
// Binary CAD data is NOT stored here. FileVersion.storageKey is a
// pointer to future object storage.
// ============================================================

model CadDocument {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  documentNumber String
  fileName       String
  documentType   CadDocumentType
  description    String?

  // Set from the authenticated actor on the server, never from the client.
  createdById String
  createdBy   User   @relation(fields: [organizationId, createdById], references: [organizationId, id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fileVersions  FileVersion[]
  revisionLinks ItemRevisionDocument[]

  // CAD reference graph (Milestone 2). Directional edges:
  //   outgoingDependencies -> documents THIS document references / uses
  //   incomingDependencies -> documents that reference THIS document ("where used")
  outgoingDependencies CadDependency[] @relation("CadDependencyParent")
  incomingDependencies CadDependency[] @relation("CadDependencyChild")

  // At most one row - see CadCheckout's own doc comment for why a plain
  // optional relation (backed by a unique constraint) is sufficient.
  checkout CadCheckout?

  // Durable checkout-lifecycle history (P3C-3) - survives after the live
  // CadCheckout row above is deleted. See CadCheckoutEvent's doc comment.
  checkoutEvents CadCheckoutEvent[]

  // Frozen release-baseline pins naming this document (P3D-1) - see
  // ReleaseBaselineEntry's doc comment.
  releaseBaselineEntries ReleaseBaselineEntry[]

  @@unique([organizationId, id])
  @@unique([organizationId, documentNumber])
  @@index([organizationId])
  @@index([createdById])
}

// ============================================================
// ITEM REVISION <-> CAD DOCUMENT LINK  (PDM)
//
// Explicit join between an engineering revision and a CAD document.
// The same CadDocument may be linked to multiple ItemRevisions over
// its life (e.g. Rev A and Rev B both reference 10073-MFD-AS210.iam).
//
// All three foreign keys are composite and organization-aware, so a
// link can only ever join an ItemRevision and a CadDocument that both
// belong to the SAME organization. Cross-tenant links are impossible
// at the database level.
// ============================================================

model ItemRevisionDocument {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  itemRevisionId String
  itemRevision   ItemRevision @relation(fields: [organizationId, itemRevisionId], references: [organizationId, id], onDelete: Cascade)

  cadDocumentId String
  cadDocument   CadDocument @relation(fields: [organizationId, cadDocumentId], references: [organizationId, id], onDelete: Cascade)

  // Set from the authenticated actor on the server, never from the client.
  createdById String
  createdBy   User   @relation(fields: [organizationId, createdById], references: [organizationId, id])

  createdAt DateTime @default(now())

  @@unique([organizationId, id])
  // A CadDocument can be linked to a given ItemRevision at most once.
  @@unique([itemRevisionId, cadDocumentId])
  @@index([organizationId])
  @@index([itemRevisionId])
  @@index([cadDocumentId])
  @@index([createdById])
}

// ============================================================
// FILE VERSION  (PDM)
//
// A physical, immutable version of a CadDocument: V1, V2, V3 ...
//
// versionNumber is an integer assigned server-side. It is fully
// independent of the engineering revision letter.
// ============================================================

model FileVersion {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Composite tenant-aware FK: a FileVersion can only ever point at a
  // CadDocument in the SAME organization.
  cadDocumentId String
  cadDocument   CadDocument @relation(fields: [organizationId, cadDocumentId], references: [organizationId, id], onDelete: Cascade)

  versionNumber Int

  originalFileName String
  // Metadata-only pointer to future object storage. No binary data in PostgreSQL.
  storageKey       String
  fileSize         BigInt?
  checksum         String?

  createdById String
  createdBy   User   @relation(fields: [organizationId, createdById], references: [organizationId, id])

  createdAt DateTime @default(now())

  // A FileVersion that has ever been captured as a checkout's base. Not
  // constrained to one - see CadCheckout's doc comment.
  baseForCheckouts CadCheckout[]
  // Same, but recorded durably in checkout HISTORY (P3C-3) - see
  // CadCheckoutEvent's doc comment.
  baseForCheckoutEvents CadCheckoutEvent[]
  // Pinned into a frozen engineering release baseline (P3D-1) - see
  // ReleaseBaselineEntry's doc comment.
  baselineEntries ReleaseBaselineEntry[]

  // Guarantees a CadDocument can never hold two rows with the same version.
  @@unique([cadDocumentId, versionNumber])
  @@unique([organizationId, id])
  // P3D-1: lets ReleaseBaselineEntry's FK be a composite
  // (organizationId, cadDocumentId, fileVersionId) that references THIS
  // constraint - which mathematically forces the referenced FileVersion's
  // OWN cadDocumentId to match the entry's cadDocumentId. A plain
  // (organizationId, id) FK alone could not prove that; see
  // ReleaseBaselineEntry's doc comment for the full reasoning.
  @@unique([organizationId, cadDocumentId, id])
  @@index([organizationId])
  @@index([cadDocumentId])
  @@index([createdById])
}

// ============================================================
// CAD DEPENDENCY  (PDM Milestone 2 - CAD reference graph)
//
// A directional edge between two CAD documents in the SAME
// organization:
//
//   parentDocument  --(dependencyType)-->  childDocument
//
//   Assembly.iam  --COMPONENT-->          Part.ipt
//   Assembly.iam  --COMPONENT-->          Subassembly.iam
//   Drawing.idw   --DRAWING_REFERENCE-->  Assembly.iam
//
// ARCHITECTURAL DECISION: dependencies are between logical CAD
// DOCUMENTS, not individual FileVersions. The logical reference
// ("Assembly.iam uses Part.ipt") survives across file versions.
// A version-specific dependency snapshot captured at check-in /
// release is a deliberately separate, future concern.
//
// All three foreign keys are composite and organization-aware:
// parentDocument, childDocument and createdBy must ALL belong to
// this row's organization. A cross-tenant edge is impossible at
// the database level.
// ============================================================

model CadDependency {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  parentDocumentId String
  parentDocument   CadDocument @relation("CadDependencyParent", fields: [organizationId, parentDocumentId], references: [organizationId, id], onDelete: Cascade)

  childDocumentId String
  childDocument   CadDocument @relation("CadDependencyChild", fields: [organizationId, childDocumentId], references: [organizationId, id], onDelete: Cascade)

  dependencyType CadDependencyType

  // Set from the authenticated actor on the server, never from the client.
  createdById String
  createdBy   User   @relation(fields: [organizationId, createdById], references: [organizationId, id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, id])
  // The same directional edge + type cannot be recorded twice.
  @@unique([organizationId, parentDocumentId, childDocumentId, dependencyType])
  @@index([organizationId])
  @@index([parentDocumentId])
  @@index([childDocumentId])
  @@index([createdById])
}

// ============================================================
// CAD CHECKOUT  (PDM P3C-1 - server-authoritative exclusive editing lock)
//
// Checkout belongs to the logical CadDocument, NOT to a single FileVersion.
// It records the EXACT FileVersion that was the newest binary-backed version
// at the moment checkout began ("the base"), so a future check-in can
// compare against it - but checkout itself never creates a FileVersion,
// never touches ItemRevision/lifecycle, and never touches CadDependency.
//
// THIS MILESTONE HAS NO CHECK-IN, undo, admin unlock, or expiration: a
// CadCheckout row, once created, is never deleted, closed, or superseded.
// Because of that, "this CadDocument has an active checkout" and "this
// CadDocument has ANY CadCheckout row" are the EXACT SAME condition today, so
// a single unique constraint on (organizationId, cadDocumentId) is
// sufficient, DB-enforced exclusivity - at most one checkout can ever exist
// per document, full stop. No explicit active/closed state, timeout, or
// lease column is needed (or wanted) yet.
//
// This is also the whole concurrency strategy: two actors racing to check
// out the same CadDocument both attempt `CadCheckout.create()`; the unique
// index lets exactly one succeed, and the loser's insert fails with a
// unique-constraint violation, which the application layer turns into
// either an idempotent "you already hold it" response (same actor) or a 409
// conflict naming the other actor (different actor). No row-locking
// transaction is required - the unique index IS the serialization point.
//
// A future check-in milestone can DELETE this row on check-in (the
// constraint keeps working unmodified), or, if checkout HISTORY must be
// preserved, replace this with a closedAt column and a partial unique index
// (WHERE "closedAt" IS NULL) instead - deliberately NOT decided here.
// ============================================================

model CadCheckout {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Composite tenant-aware FK: a checkout can only ever target a CadDocument
  // in the SAME organization. Together with the unique constraint below, at
  // most one checkout can ever exist for a given (organizationId,
  // cadDocumentId) pair.
  cadDocumentId String
  cadDocument   CadDocument @relation(fields: [organizationId, cadDocumentId], references: [organizationId, id], onDelete: Cascade)

  // The exact FileVersion that was the newest binary-backed version at the
  // moment checkout began. Never re-resolved afterward - uploading a newer
  // FileVersion does NOT change this row. Restrict (not cascade): a
  // FileVersion is immutable and must not silently disappear out from under
  // an active lock.
  baseFileVersionId String
  baseFileVersion   FileVersion @relation(fields: [organizationId, baseFileVersionId], references: [organizationId, id], onDelete: Restrict)

  // Set from the authenticated actor on the server, never from the client.
  checkedOutById String
  checkedOutBy   User   @relation(fields: [organizationId, checkedOutById], references: [organizationId, id], onDelete: Restrict)

  checkedOutAt DateTime @default(now())

  // Optional free-text note from the actor at checkout time (e.g. "fixing
  // the mount hole pattern"). Never required, never interpreted by the server.
  note String?

  @@unique([organizationId, id])
  // At most one checkout per CadDocument - see the model comment above.
  @@unique([organizationId, cadDocumentId])
  @@index([organizationId])
  @@index([baseFileVersionId])
  @@index([checkedOutById])
}

// ============================================================
// CAD CHECKOUT EVENT  (P3C-3 - durable checkout lifecycle history)
//
// CadCheckout rows are DELETED the instant a checkout is consumed
// (Check-In) or released (Undo Checkout, Admin Unlock) - see CadCheckout's
// own doc comment. Without a separate durable record, that deletion would
// silently erase who held a document, when, and why it was released. This
// model is that minimal, forward-compatible, append-only history - NOT a
// generic enterprise audit framework: it records exactly the four
// checkout-lifecycle events (CHECKED_OUT, CHECKED_IN, UNDO_CHECKOUT,
// ADMIN_UNLOCK) and nothing else.
//
// `checkoutId` is DELIBERATELY NOT a foreign key. The CadCheckout row it
// names is deleted in the SAME transaction that inserts this event (for
// every event type except CHECKED_OUT), so there is nothing durable left to
// reference once the transaction commits - a Restrict FK would make that
// delete impossible, and a Cascade FK would delete the very event meant to
// survive it. It is recorded as a plain historical identifier only.
//
// IDENTITY, NOT DISPLAY DATA: `checkoutOwnerId` / `actedById` are User IDs,
// never names or emails - a name is mutable display data, not a stable
// historical identity. A caller that needs a display name joins it
// separately, scoped to its own tenant, at read time.
//
// FK / DELETE STRATEGY (deliberate, not the schema-wide default): every
// live FK below (cadDocumentId, baseFileVersionId, checkoutOwnerId,
// actedById) uses onDelete: Restrict, NEVER Cascade - even though
// CadCheckout's OWN cadDocumentId FK cascades. History must OUTLIVE the
// records it is about: if a CadDocument or User were ever deleted (no such
// path exists anywhere in this app today), Restrict means that delete is
// refused while checkout history still names it, rather than silently
// erasing the audit trail. FileVersion rows are immutable and never
// deleted in this schema, so Restrict there is a safety net, not a live
// constraint. Widening any of these to Cascade later must be a deliberate,
// audited decision - not a side effect of an unrelated schema change.
// ============================================================

model CadCheckoutEvent {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Composite tenant-aware FK, Restrict (not Cascade) - see the model
  // comment above.
  cadDocumentId String
  cadDocument   CadDocument @relation(fields: [organizationId, cadDocumentId], references: [organizationId, id], onDelete: Restrict)

  // Historical identifier only - NOT a foreign key. See the model comment.
  checkoutId String

  // The FileVersion the checkout was based on. FileVersions are immutable
  // and never deleted, so this stays resolvable in practice; Restrict
  // regardless, matching CadCheckout.baseFileVersionId's own reasoning.
  baseFileVersionId String
  baseFileVersion   FileVersion @relation(fields: [organizationId, baseFileVersionId], references: [organizationId, id], onDelete: Restrict)

  // Who HELD the checkout (copied from CadCheckout.checkedOutById at the
  // moment of the event - the checkout row itself is about to be deleted).
  checkoutOwnerId String
  checkoutOwner   User   @relation("CadCheckoutEventOwner", fields: [organizationId, checkoutOwnerId], references: [organizationId, id], onDelete: Restrict)

  // Who PERFORMED this event. Equal to checkoutOwnerId for CHECKED_OUT /
  // CHECKED_IN / UNDO_CHECKOUT (an actor only ever consumes/releases their
  // OWN checkout there); DIFFERS for ADMIN_UNLOCK (the acting admin, not
  // the checkout's owner).
  actedById String
  actedBy   User   @relation("CadCheckoutEventActor", fields: [organizationId, actedById], references: [organizationId, id], onDelete: Restrict)

  eventType CadCheckoutEventType

  // When the ORIGINAL checkout began (copied from CadCheckout.checkedOutAt) -
  // preserved because the live checkout row is gone.
  checkedOutAt DateTime

  // When THIS event happened.
  occurredAt DateTime @default(now())

  // Optional for UNDO_CHECKOUT, required by application logic (not a DB
  // constraint - see app/lib/checkout-release-core.ts) for ADMIN_UNLOCK.
  // Bounded length, trimmed, control characters stripped before storage -
  // never a place for secrets or system data.
  reason String?

  @@index([organizationId, cadDocumentId, occurredAt])
  @@index([organizationId, checkoutOwnerId])
  @@index([organizationId, actedById])
}

// ============================================================
// RELEASE BASELINE  (P3D-1 - frozen engineering release snapshot)
//
// When an ItemRevision transitions to RELEASED, this permanently captures
// the EXACT CAD FileVersion that constituted that release for each
// DIRECTLY associated CadDocument (ItemRevisionDocument links only - the
// full CadDependency graph closure is explicitly OUT of scope here; see
// ReleaseBaselineEntry). A later FileVersion on the same CadDocument (a
// direct upload, or a NEW check-in after further checkout/edit) never
// moves this baseline - it is evidence of what the release WAS, not a live
// view of the document's current state (that remains
// ItemRevisionDocument's job - see that model's own doc comment).
//
// ONE baseline per ItemRevision: `@@unique([organizationId,
// itemRevisionId])` is deliberately the SAME "optional 1:1 relation backed
// by a unique constraint" pattern as CadDocument.checkout - it is both the
// modeling choice (ItemRevision.releaseBaseline is `ReleaseBaseline?`) and
// the DB-enforced backstop for "a repeated release request must never
// create a second baseline": the application layer already refuses this
// (advanceRevisionForActor's terminal-lifecycle guard rejects any lifecycle
// change, including a second RELEASED transition, on a revision that is
// already RELEASED/terminal - see app/lib/release-db.ts), so this
// constraint should never actually fire in normal operation, but it is the
// database's own proof that it cannot, regardless of what future
// application code does.
//
// IMMUTABILITY (P3D-1, application-level + strong DB constraints - no
// admin override, no update/delete path exposed anywhere):
//   - no route/action ever calls .update() or .delete() on ReleaseBaseline
//     or ReleaseBaselineEntry;
//   - onDelete: Restrict on itemRevisionId / createdById (see below) means
//     the evidence this row represents cannot be silently erased by
//     deleting the ItemRevision or User it names, even though no such
//     delete path exists anywhere in this app today - if one is ever
//     added, it must reckon with released evidence deliberately, not by
//     accident.
//
// AUDIT, NOT A GENERIC FRAMEWORK: only createdById + createdAt are
// captured. No broader audit-event model is introduced here - see
// CadCheckoutEvent for the (separate, already-existing) checkout-history
// mechanism, which this deliberately does not duplicate or extend.
// ============================================================

model ReleaseBaseline {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Composite tenant-aware FK, Restrict (not Cascade) - released evidence
  // must outlive the revision record if that record is ever deletable in
  // the future (no such path exists today).
  itemRevisionId String
  itemRevision   ItemRevision @relation(fields: [organizationId, itemRevisionId], references: [organizationId, id], onDelete: Restrict)

  // Set from the authenticated actor on the server, never from the client.
  // Restrict - the same "evidence must outlive the User it names" reasoning
  // used throughout (CadCheckoutEvent, etc).
  createdById String
  createdBy   User   @relation(fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict)

  createdAt DateTime @default(now())

  entries ReleaseBaselineEntry[]

  @@unique([organizationId, id])
  // At most one baseline per revision - see the model comment above.
  @@unique([organizationId, itemRevisionId])
  @@index([organizationId])
  @@index([createdById])
}

// ============================================================
// RELEASE BASELINE ENTRY  (P3D-1, extended P3D-3)
//
// One pinned (CadDocument, FileVersion) pair per CadDocument in the release's
// dependency-complete closure at the moment of release:
//   - every CadDocument DIRECTLY associated with the ItemRevision via
//     ItemRevisionDocument (inclusionKind = DIRECT), AND
//   - every CadDocument reachable from those via the outgoing CadDependency
//     closure - parentDocumentId -> childDocumentId, recursively
//     (inclusionKind = DEPENDENCY).
// Exactly one entry per CadDocument per baseline (a document reached both
// ways is stored once, as DIRECT). P3D-1 baselines predate the closure walk
// and contain DIRECT entries only; `inclusionKind` defaults to DIRECT so
// those historical rows read back truthfully and are never re-expanded using
// today's graph.
//
// KEY CONSTRAINT - proving fileVersionId actually belongs to cadDocumentId:
// a naive `fileVersionId -> FileVersion(organizationId, id)` FK only proves
// the FileVersion exists in the SAME organization - nothing stops a caller
// (or a bug) from pairing cadDocumentId=Assembly.iam with a fileVersionId
// that actually belongs to Frame.ipt. Instead, this FK is the COMPOSITE
// (organizationId, cadDocumentId, fileVersionId), referencing FileVersion's
// (organizationId, cadDocumentId, id) unique constraint (added in P3D-1
// specifically to make this possible). Because FileVersion's OWN
// cadDocumentId is part of that referenced key, the database itself proves
// the pinned FileVersion belongs to the pinned CadDocument - a mismatched
// pair is a foreign-key violation, not just an application-level bug that
// could slip through.
//
// Deliberately does NOT store originalFileName / any display data:
// "released snapshot identity must not depend on filename" - the pinned
// identity is (cadDocumentId, fileVersionId) only. A caller needing display
// data joins CadDocument / FileVersion at read time.
//
// FK strategy: cadDocumentId and the FileVersion composite FK both use
// Restrict (never Cascade) - the SAME "evidence must outlive the thing it
// names" reasoning as ReleaseBaseline itself; releaseBaselineId uses
// Cascade because an entry has no independent meaning once its OWNING
// baseline is gone (P3D-1 exposes no delete path for ReleaseBaseline at
// all, so this never actually fires - it exists only for referential
// consistency if a baseline were ever administratively removed later).
// ============================================================

model ReleaseBaselineEntry {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  releaseBaselineId String
  releaseBaseline   ReleaseBaseline @relation(fields: [organizationId, releaseBaselineId], references: [organizationId, id], onDelete: Cascade)

  cadDocumentId String
  cadDocument   CadDocument @relation(fields: [organizationId, cadDocumentId], references: [organizationId, id], onDelete: Restrict)

  // Composite FK proving fileVersionId belongs to cadDocumentId - see the
  // model comment above. NOT a plain (organizationId, id) reference.
  fileVersionId String
  fileVersion   FileVersion @relation(fields: [organizationId, cadDocumentId, fileVersionId], references: [organizationId, cadDocumentId, id], onDelete: Restrict)

  // P3D-3: whether this document was directly associated with the revision or
  // pulled in through the CadDependency closure. Additive; DIRECT default
  // backfills existing P3D-1 entries, which were all direct.
  inclusionKind ReleaseBaselineInclusionKind @default(DIRECT)

  createdAt DateTime @default(now())

  @@unique([organizationId, id])
  // One entry per CadDocument per baseline.
  @@unique([releaseBaselineId, cadDocumentId])
  @@index([organizationId])
  @@index([releaseBaselineId])
  @@index([cadDocumentId])
  @@index([fileVersionId])
}
