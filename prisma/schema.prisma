// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ARCH PLM - CORE ENUMS
// ============================================================

enum UserRole {
  ADMIN
  ENGINEER
  DESIGNER
  REVIEWER
  APPROVER
  VIEWER
}

enum ItemType {
  PART
  ASSEMBLY
  DOCUMENT
}

enum LifecycleState {
  WORKING
  IN_REVIEW
  APPROVED
  RELEASED
  SUPERSEDED
  OBSOLETE
}

// B03: what caused an ItemRevisionLifecycleEvent.
enum LifecycleEventTrigger {
  // A user-requested transition through advanceRevisionForActor.
  MANUAL
  // A RELEASED source revision moved to SUPERSEDED because its successor was
  // released in the same transaction (actor = the user who released the
  // successor).
  AUTOMATIC_SUPERSESSION
  // Option A: a step in closing a held legacy revision (-> WORKING ->
  // OBSOLETE) as part of revalidating it into a fresh successor revision.
  LEGACY_REVALIDATION
}

// PDM: physical CAD document formats. Engineering revision lifecycle
// (LifecycleState) is deliberately unrelated to CAD file versioning.
enum CadDocumentType {
  IPT
  IAM
  IDW
  DWG
  PDF
  OTHER
}

// PDM: the kind of directional relationship between two CAD documents.
//   COMPONENT          IAM assembly contains/references an IPT or IAM component
//   DRAWING_REFERENCE  IDW/DWG drawing references an IAM/IPT model
//   DERIVED            a CAD document is derived from another CAD document
//   REFERENCE          generic external/reference relationship
//   OTHER              fallback
enum CadDependencyType {
  COMPONENT
  DRAWING_REFERENCE
  DERIVED
  REFERENCE
  OTHER
}

// Checkout lifecycle events recorded durably (P3C-3) - see CadCheckoutEvent.
enum CadCheckoutEventType {
  CHECKED_OUT
  CHECKED_IN
  UNDO_CHECKOUT
  ADMIN_UNLOCK
}

// How a CadDocument came to be pinned into a ReleaseBaseline (P3D-3) - see
// ReleaseBaselineEntry. DIRECT = associated with the ItemRevision via
// ItemRevisionDocument at release time; DEPENDENCY = reached only through the
// outgoing CadDependency closure of a direct document. If a document is both,
// DIRECT wins (there is still exactly one entry per document per baseline).
enum ReleaseBaselineInclusionKind {
  DIRECT
  DEPENDENCY
}

// What a P6B CopyDesignOperationEntry decided for one plan entry - see that
// model's own doc comment.
enum CopyDesignEntryAction {
  COPY
  REUSE
}

// ============================================================
// ORGANIZATION
// ============================================================

model Organization {
  id   String @id @default(cuid())
  name String
  code String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                      User[]
  customers                  Customer[]
  projects                   Project[]
  items                      Item[]
  itemRevisions              ItemRevision[]
  cadDocuments               CadDocument[]
  fileVersions               FileVersion[]
  itemRevisionDocuments      ItemRevisionDocument[]
  cadDependencies            CadDependency[]
  cadCheckouts               CadCheckout[]
  cadCheckoutEvents          CadCheckoutEvent[]
  releaseBaselines           ReleaseBaseline[]
  releaseBaselineEntries     ReleaseBaselineEntry[]
  desktopSessions            DesktopSession[]
  copyDesignOperations       CopyDesignOperation[]
  cadCopyLineages            CadCopyLineage[]
  copyDesignOperationEntries CopyDesignOperationEntry[]
  lifecycleEvents            ItemRevisionLifecycleEvent[]
  legacyLifecycleHolds       ItemRevisionLegacyLifecycleHold[]
  legacyRevalidations        ItemRevisionLegacyRevalidation[]
}

// ============================================================
// USER
// ============================================================

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  email        String
  name         String
  passwordHash String?
  lastLoginAt  DateTime?

  role   UserRole @default(ENGINEER)
  active Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdCadDocuments          CadDocument[]
  createdFileVersions          FileVersion[]
  createdItemRevisionDocuments ItemRevisionDocument[]
  createdCadDependencies       CadDependency[]
  createdItemRevisions         ItemRevision[]
  // Documents this user currently holds a server-authoritative checkout on.
  // NOT a "created by" relation - see CadCheckout.
  cadCheckouts                 CadCheckout[]

  // Checkout history (P3C-3): two DISTINCT relations since a
  // CadCheckoutEvent names both who HELD the checkout and who PERFORMED the
  // release (they differ for ADMIN_UNLOCK) - see CadCheckoutEvent.
  checkoutEventsAsOwner CadCheckoutEvent[] @relation("CadCheckoutEventOwner")
  checkoutEventsAsActor CadCheckoutEvent[] @relation("CadCheckoutEventActor")

  // Frozen release baselines this user created (P3D-1).
  createdReleaseBaselines ReleaseBaseline[]

  // Bearer sessions issued to this user's desktop CAD Connect clients (P4A).
  desktopSessions DesktopSession[]

  // Copy Design operations this user performed, and the individual copy
  // lineage rows they created (P6B) - see CopyDesignOperation /
  // CadCopyLineage.
  performedCopyDesignOperations CopyDesignOperation[]
  copiedCadLineages             CadCopyLineage[]

  // Lifecycle transitions this user performed (B03) - see
  // ItemRevisionLifecycleEvent.
  lifecycleEventsActed ItemRevisionLifecycleEvent[] @relation("ItemRevisionLifecycleEventActor")

  // Legacy revisions this user revalidated (Option A) - see
  // ItemRevisionLegacyRevalidation.
  legacyRevalidationsActed ItemRevisionLegacyRevalidation[] @relation("LegacyRevalidationActor")

  // Enables tenant-aware composite foreign keys that reference a user
  // together with their organization.
  @@unique([organizationId, id])
  @@unique([organizationId, email])
  @@index([organizationId])
}

// ============================================================
// CUSTOMER
// ============================================================

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name           String
  customerNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]

  @@unique([organizationId, id])
  @@unique([organizationId, customerNumber])
  @@index([organizationId])
}

// ============================================================
// PROJECT
// ============================================================

model Project {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)

  projectNumber String
  name          String
  description   String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items Item[]

  @@unique([organizationId, id])
  @@unique([organizationId, projectNumber])
  @@index([organizationId])
  @@index([customerId])
}

// ============================================================
// ITEM
//
// Permanent engineering identity.
// Example: 10073-MFD-AS210
// ============================================================

model Item {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  projectId String?
  project   Project? @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict)

  itemNumber  String
  description String
  type        ItemType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisions ItemRevision[]

  @@unique([organizationId, id])
  @@unique([organizationId, itemNumber])
  @@index([organizationId])
  @@index([projectId])
  @@index([itemNumber])
}

// ============================================================
// ITEM REVISION
//
// Item 10073-MFD-AS210
//   Rev A
//   Rev B
//
// Revision != CAD file version
// ============================================================

model ItemRevision {
  id String @id @default(cuid())

  // Denormalized tenant key, consistent with Item / Project / Customer.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  itemId String
  item   Item   @relation(fields: [organizationId, itemId], references: [organizationId, id], onDelete: Cascade)

  revision    String
  description String?

  lifecycle  LifecycleState @default(WORKING)
  releasedAt DateTime?

  // Milestone 3: audit lineage. Set from the authenticated actor on the
  // server, never from the client. Tenant-scoped via composite FKs.
  //
  // NULLABLE on purpose: historical ItemRevision rows created before this
  // milestone have no recoverable creator, and we do NOT fabricate one.
  // Every revision the application creates (createItem, createEngineeringRevision)
  // always sets createdById = actor.userId; a NULL means "pre-lineage".
  createdById String?
  createdBy   User?   @relation(fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)

  // The revision this one was derived from ("Create next revision").
  // Same organization (composite FK) and, enforced in the action, same Item.
  sourceRevisionId String?
  sourceRevision   ItemRevision?  @relation("ItemRevisionLineage", fields: [organizationId, sourceRevisionId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  derivedRevisions ItemRevision[] @relation("ItemRevisionLineage")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // CAD documents are linked through ItemRevisionDocument, not owned directly.
  documentLinks ItemRevisionDocument[]

  // At most one row - see ReleaseBaseline's own doc comment for why a plain
  // optional relation (backed by a unique constraint) is sufficient, exactly
  // like CadDocument.checkout.
  releaseBaseline ReleaseBaseline?

  // Append-only lifecycle history (B03) - see ItemRevisionLifecycleEvent.
  lifecycleEvents     ItemRevisionLifecycleEvent[]
  // Present iff this revision existed before B03 (its pre-B03 history is
  // unverifiable) - see ItemRevisionLegacyLifecycleHold.
  legacyLifecycleHold ItemRevisionLegacyLifecycleHold?

  // Option A: present on a legacy revision that was revalidated (closed) /
  // on the successor revision it produced - see ItemRevisionLegacyRevalidation.
  legacyRevalidationAsLegacy    ItemRevisionLegacyRevalidation? @relation("LegacyRevalidationLegacy")
  legacyRevalidationAsSuccessor ItemRevisionLegacyRevalidation? @relation("LegacyRevalidationSuccessor")

  @@unique([organizationId, id])
  @@unique([itemId, revision])
  @@index([organizationId])
  @@index([itemId])
  @@index([lifecycle])
  @@index([createdById])
  @@index([sourceRevisionId])
}

// ============================================================
// B03: append-only engineering revision lifecycle history.
//
// Exactly one row is written, in the SAME SERIALIZABLE transaction as the
// state change it records, for every successful lifecycle transition
// (`advanceRevisionForActor`, app/lib/release-db.ts), plus one
// AUTOMATIC_SUPERSESSION row when a successor's release supersedes its
// RELEASED source. A refused or rolled-back transition leaves no row.
//
// These rows are the ONLY record of who submitted a revision for review and
// who approved it, so the separation-of-duties rules in
// app/lib/lifecycle-policy-core.ts are evaluated against them.
//
// APPEND-ONLY: the application never updates or deletes a row, and the
// migration installs a database trigger that rejects UPDATE, DELETE and
// TRUNCATE on this table (Product Owner decision D-A8). All foreign keys are
// Restrict in both directions, so the history can never be removed or
// rewritten by a cascade either. No history is backfilled or fabricated:
// revisions that existed before B03 get an ItemRevisionLegacyLifecycleHold
// instead (see below).
//
// ORDER: `sequence` is the AUTHORITATIVE transition order. It is assigned by
// a database sequence at INSERT time. Transitions of one revision are
// serialized (conditional row update under SERIALIZABLE), and each event is
// inserted inside its transition's transaction after the previous transition
// committed, so per revision, sequence order = commit order. `occurredAt`
// (application clock, same instant as releasedAt) is informational only and
// is NEVER used to order history or to make an authorization decision.
// ============================================================
model ItemRevisionLifecycleEvent {
  id String @id @default(cuid())

  // Authoritative, database-assigned transition order (see above).
  sequence BigInt @unique @default(autoincrement())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  itemRevisionId String
  itemRevision   ItemRevision @relation(fields: [organizationId, itemRevisionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  fromState LifecycleState
  toState   LifecycleState
  trigger   LifecycleEventTrigger

  // Who performed the transition (for AUTOMATIC_SUPERSESSION: the user who
  // released the successor), and their role at that moment - read from the
  // database inside the transaction, never from the client.
  actedById   String
  actedBy     User     @relation("ItemRevisionLifecycleEventActor", fields: [organizationId, actedById], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  actedByRole UserRole

  // Optional human comment (e.g. why a revision was returned from review).
  // Trimmed, control characters stripped, bounded length - see
  // normalizeLifecycleComment. Never a place for secrets or system data.
  comment String?

  // Set explicitly by the transaction, to the same instant as
  // ItemRevision.releasedAt for a release. Informational: display only, never
  // used for ordering (use `sequence`).
  occurredAt DateTime

  @@index([organizationId, itemRevisionId, sequence])
  @@index([organizationId, actedById])
}

// ============================================================
// B03 (Codex NO-GO finding 1): legacy lifecycle hold.
//
// One row per ItemRevision that ALREADY EXISTED when the B03 migration ran,
// written by that migration (INSERT ... SELECT from ItemRevision) and never
// by the application. For such a revision, who submitted it for review before
// B03 cannot be verified, so separation of duties cannot be proven: approve
// and release are refused for as long as the row exists - and the row is
// append-only (same trigger as the event table), so nothing in the
// application can lift the hold. Returning to Working and resubmitting does
// NOT remove it. Creator and history are left untouched; no submitter is
// fabricated. Safe revalidation is a separate, not-yet-approved design.
// ============================================================
model ItemRevisionLegacyLifecycleHold {
  itemRevisionId String @id

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  itemRevision   ItemRevision @relation(fields: [organizationId, itemRevisionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  // The revision's lifecycle when the hold was recorded (evidence only).
  lifecycleAtHold LifecycleState
  // Database time of the migration that recorded the hold.
  recordedAt      DateTime       @default(now())

  @@unique([organizationId, itemRevisionId])
  @@index([organizationId])
}

// ============================================================
// Option A: legacy revalidation audit link (append-only).
//
// One row per held legacy revision that was revalidated: in ONE SERIALIZABLE
// transaction the legacy revision was closed (-> OBSOLETE through recorded
// LEGACY_REVALIDATION events; never approved or released; hold, creator and
// history untouched) and a fresh WORKING successor revision was created with
// the actor as its trusted creator. Written only by
// revalidateLegacyRevisionForActor (app/lib/legacy-revalidation-db.ts).
//
// legacyRevisionId and successorRevisionId are each UNIQUE: at most one
// successor per legacy revision (duplicate guard), and a successor belongs to
// exactly one legacy revision. The row also drives Product Owner decision
// O-2 (the legacy creator, post-B03 legacy submitters and this actor may not
// approve or release the successor) and O-4 (releasing the successor
// supersedes the legacy revision's RELEASED source). The required reason
// (O-5) is stored in `comment`. Same append-only database triggers as the
// B03 tables; all foreign keys organization-scoped and RESTRICT.
// ============================================================
model ItemRevisionLegacyRevalidation {
  id String @id @default(cuid())

  // Database-assigned order (same convention as ItemRevisionLifecycleEvent).
  sequence BigInt @unique @default(autoincrement())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  legacyRevisionId String       @unique
  legacyRevision   ItemRevision @relation("LegacyRevalidationLegacy", fields: [organizationId, legacyRevisionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  successorRevisionId String       @unique
  successorRevision   ItemRevision @relation("LegacyRevalidationSuccessor", fields: [organizationId, successorRevisionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  // Who revalidated, and their role at that moment (re-read in the transaction).
  actedById   String
  actedBy     User     @relation("LegacyRevalidationActor", fields: [organizationId, actedById], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  actedByRole UserRole

  // Required reason (O-5): normalized, non-empty, at most 500 characters.
  comment String

  // Same instant as the closure events (application clock; informational).
  occurredAt DateTime

  @@unique([organizationId, legacyRevisionId])
  @@unique([organizationId, successorRevisionId])
  @@index([organizationId, actedById])
}

// ============================================================
// CAD DOCUMENT  (PDM)
//
// A logical CAD document identity, e.g. 10073-MFD-AS210.iam
//
// ITEM != ENGINEERING REVISION != CAD DOCUMENT != FILE VERSION
//
// A CadDocument belongs to the Organization, NOT to a single
// ItemRevision. Its identity (and full file-version history) survives
// across engineering revisions. Association with one or more
// ItemRevisions is expressed through the ItemRevisionDocument link.
//
// Saving a newer CAD file adds a FileVersion; it never touches
// ItemRevision.revision or ItemRevision.lifecycle and never creates
// an ItemRevision.
//
// Binary CAD data is NOT stored here. FileVersion.storageKey is a
// pointer to future object storage.
// ============================================================

// P6D ROUND 2, HIGH fix: `documentNumber` alone used to be the organization-
// wide unique business key (`@@unique([organizationId, documentNumber])`),
// which made a normal Inventor model/drawing pair - e.g. "1001.ipt" and
// "1001.idw", the SAME engineering base number, two DIFFERENT CadDocuments
// per the PDM CAD architecture rule (ITEM != REVISION != CAD DOC != FILE
// VERSION - a drawing is its own CadDocument, never the same one as its
// model) - impossible to both create: Copy Design (or any other creator)
// deriving `newDocumentNumber` from the destination file name's stem would
// collide "1001" against itself for the .ipt and the .idw alike.
//
// The identity is now SCOPED BY documentType too:
// `@@unique([organizationId, documentNumber, documentType])`. This is
// STRICTLY LESS restrictive than before (any data that was valid under the
// old constraint - documentNumber alone unique per org - remains
// automatically valid under this one, since documentNumber-uniqueness
// trivially implies (documentNumber, documentType)-uniqueness), so the
// migration that changed this is safe to apply over existing data with no
// possibility of a duplicate-row failure.
//
// CONSEQUENCE for number-only resolution: `documentNumber` is no longer
// guaranteed unique BY ITSELF - a caller resolving "1001" with no
// documentType now gets 0, 1, or (legitimately) 2+ matches. See
// `desktop-cad-documents-core.ts` / `-db.ts` for how the bootstrap resolve-
// by-number endpoint now fails closed (409) on an ambiguous match rather
// than silently picking one row, and requires documentType (or the stable
// cadDocumentId) to disambiguate.
model CadDocument {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  documentNumber String
  fileName       String
  documentType   CadDocumentType
  description    String?

  // Set from the authenticated actor on the server, never from the client.
  createdById String
  createdBy   User   @relation(fields: [organizationId, createdById], references: [organizationId, id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fileVersions  FileVersion[]
  revisionLinks ItemRevisionDocument[]

  // CAD reference graph (Milestone 2). Directional edges:
  //   outgoingDependencies -> documents THIS document references / uses
  //   incomingDependencies -> documents that reference THIS document ("where used")
  outgoingDependencies CadDependency[] @relation("CadDependencyParent")
  incomingDependencies CadDependency[] @relation("CadDependencyChild")

  // At most one row - see CadCheckout's own doc comment for why a plain
  // optional relation (backed by a unique constraint) is sufficient.
  checkout CadCheckout?

  // Durable checkout-lifecycle history (P3C-3) - survives after the live
  // CadCheckout row above is deleted. See CadCheckoutEvent's doc comment.
  checkoutEvents CadCheckoutEvent[]

  // Frozen release-baseline pins naming this document (P3D-1) - see
  // ReleaseBaselineEntry's doc comment.
  releaseBaselineEntries ReleaseBaselineEntry[]

  // P6B Copy Design lineage. At most one row - see CadCopyLineage's own doc
  // comment for why a plain optional relation (backed by a unique
  // constraint) is sufficient, exactly like CadDocument.checkout: a
  // CadDocument was either created BY a copy (exactly one lineage row naming
  // it as the new identity) or it was not (zero rows) - it can never be
  // reassigned to a different source through any API.
  copyLineageAsNew    CadCopyLineage?  @relation("CadCopyLineageNew")
  // Copy Design lineage rows naming this document as a COPY SOURCE (a
  // document can be copied from any number of times).
  copyLineageAsSource CadCopyLineage[] @relation("CadCopyLineageSource")

  // P6B Round 2 immutable operation/replay records (see
  // CopyDesignOperationEntry's own doc comment). A document can appear as
  // the named COPY source of any number of entries. It can also appear as
  // the RESULT of more than one entry across separate operations - a COPY
  // creates a document exactly once, but a REUSE entry names an EXISTING
  // document as its result, and that same document can legitimately be
  // reused again by a later, unrelated operation - so this is a to-many
  // relation, not a to-one.
  operationEntriesAsSource CopyDesignOperationEntry[] @relation("CopyDesignOperationEntrySource")
  operationEntriesAsResult CopyDesignOperationEntry[] @relation("CopyDesignOperationEntryResult")

  @@unique([organizationId, id])
  // P6D ROUND 2, HIGH fix: scoped by documentType - see the class doc
  // comment above for why. Was `@@unique([organizationId, documentNumber])`.
  @@unique([organizationId, documentNumber, documentType])
  @@index([organizationId])
  @@index([createdById])
}

// ============================================================
// ITEM REVISION <-> CAD DOCUMENT LINK  (PDM)
//
// Explicit join between an engineering revision and a CAD document.
// The same CadDocument may be linked to multiple ItemRevisions over
// its life (e.g. Rev A and Rev B both reference 10073-MFD-AS210.iam).
//
// All three foreign keys are composite and organization-aware, so a
// link can only ever join an ItemRevision and a CadDocument that both
// belong to the SAME organization. Cross-tenant links are impossible
// at the database level.
// ============================================================

model ItemRevisionDocument {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  itemRevisionId String
  itemRevision   ItemRevision @relation(fields: [organizationId, itemRevisionId], references: [organizationId, id], onDelete: Cascade)

  cadDocumentId String
  cadDocument   CadDocument @relation(fields: [organizationId, cadDocumentId], references: [organizationId, id], onDelete: Cascade)

  // Set from the authenticated actor on the server, never from the client.
  createdById String
  createdBy   User   @relation(fields: [organizationId, createdById], references: [organizationId, id])

  createdAt DateTime @default(now())

  @@unique([organizationId, id])
  // A CadDocument can be linked to a given ItemRevision at most once.
  @@unique([itemRevisionId, cadDocumentId])
  @@index([organizationId])
  @@index([itemRevisionId])
  @@index([cadDocumentId])
  @@index([createdById])
}

// ============================================================
// FILE VERSION  (PDM)
//
// A physical, immutable version of a CadDocument: V1, V2, V3 ...
//
// versionNumber is an integer assigned server-side. It is fully
// independent of the engineering revision letter.
// ============================================================

model FileVersion {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Composite tenant-aware FK: a FileVersion can only ever point at a
  // CadDocument in the SAME organization.
  cadDocumentId String
  cadDocument   CadDocument @relation(fields: [organizationId, cadDocumentId], references: [organizationId, id], onDelete: Cascade)

  versionNumber Int

  originalFileName String
  // Metadata-only pointer to future object storage. No binary data in PostgreSQL.
  storageKey       String
  fileSize         BigInt?
  checksum         String?

  createdById String
  createdBy   User   @relation(fields: [organizationId, createdById], references: [organizationId, id])

  createdAt DateTime @default(now())

  // A FileVersion that has ever been captured as a checkout's base. Not
  // constrained to one - see CadCheckout's doc comment.
  baseForCheckouts      CadCheckout[]
  // Same, but recorded durably in checkout HISTORY (P3C-3) - see
  // CadCheckoutEvent's doc comment.
  baseForCheckoutEvents CadCheckoutEvent[]
  // Pinned into a frozen engineering release baseline (P3D-1) - see
  // ReleaseBaselineEntry's doc comment.
  baselineEntries       ReleaseBaselineEntry[]

  // Named as the EXACT source of a Copy Design copy (P6B) - see
  // CadCopyLineage.sourceFileVersion's doc comment for the composite-FK
  // proof that ties this to its own cadDocumentId.
  copyLineagesAsSource CadCopyLineage[]

  // Same, but in the P6B Round 2 immutable operation/replay record - see
  // CopyDesignOperationEntry.sourceFileVersion's doc comment.
  operationEntriesAsSource CopyDesignOperationEntry[]

  // Guarantees a CadDocument can never hold two rows with the same version.
  @@unique([cadDocumentId, versionNumber])
  @@unique([organizationId, id])
  // P3D-1: lets ReleaseBaselineEntry's FK be a composite
  // (organizationId, cadDocumentId, fileVersionId) that references THIS
  // constraint - which mathematically forces the referenced FileVersion's
  // OWN cadDocumentId to match the entry's cadDocumentId. A plain
  // (organizationId, id) FK alone could not prove that; see
  // ReleaseBaselineEntry's doc comment for the full reasoning.
  @@unique([organizationId, cadDocumentId, id])
  @@index([organizationId])
  @@index([cadDocumentId])
  @@index([createdById])
}

// ============================================================
// CAD DEPENDENCY  (PDM Milestone 2 - CAD reference graph)
//
// A directional edge between two CAD documents in the SAME
// organization:
//
//   parentDocument  --(dependencyType)-->  childDocument
//
//   Assembly.iam  --COMPONENT-->          Part.ipt
//   Assembly.iam  --COMPONENT-->          Subassembly.iam
//   Drawing.idw   --DRAWING_REFERENCE-->  Assembly.iam
//
// ARCHITECTURAL DECISION: dependencies are between logical CAD
// DOCUMENTS, not individual FileVersions. The logical reference
// ("Assembly.iam uses Part.ipt") survives across file versions.
// A version-specific dependency snapshot captured at check-in /
// release is a deliberately separate, future concern.
//
// All three foreign keys are composite and organization-aware:
// parentDocument, childDocument and createdBy must ALL belong to
// this row's organization. A cross-tenant edge is impossible at
// the database level.
// ============================================================

model CadDependency {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  parentDocumentId String
  parentDocument   CadDocument @relation("CadDependencyParent", fields: [organizationId, parentDocumentId], references: [organizationId, id], onDelete: Cascade)

  childDocumentId String
  childDocument   CadDocument @relation("CadDependencyChild", fields: [organizationId, childDocumentId], references: [organizationId, id], onDelete: Cascade)

  dependencyType CadDependencyType

  // Set from the authenticated actor on the server, never from the client.
  createdById String
  createdBy   User   @relation(fields: [organizationId, createdById], references: [organizationId, id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, id])
  // The same directional edge + type cannot be recorded twice.
  @@unique([organizationId, parentDocumentId, childDocumentId, dependencyType])
  @@index([organizationId])
  @@index([parentDocumentId])
  @@index([childDocumentId])
  @@index([createdById])
}

// ============================================================
// CAD CHECKOUT  (PDM P3C-1 - server-authoritative exclusive editing lock)
//
// Checkout belongs to the logical CadDocument, NOT to a single FileVersion.
// It records the EXACT FileVersion that was the newest binary-backed version
// at the moment checkout began ("the base"), so a future check-in can
// compare against it - but checkout itself never creates a FileVersion,
// never touches ItemRevision/lifecycle, and never touches CadDependency.
//
// THIS MILESTONE HAS NO CHECK-IN, undo, admin unlock, or expiration: a
// CadCheckout row, once created, is never deleted, closed, or superseded.
// Because of that, "this CadDocument has an active checkout" and "this
// CadDocument has ANY CadCheckout row" are the EXACT SAME condition today, so
// a single unique constraint on (organizationId, cadDocumentId) is
// sufficient, DB-enforced exclusivity - at most one checkout can ever exist
// per document, full stop. No explicit active/closed state, timeout, or
// lease column is needed (or wanted) yet.
//
// This is also the whole concurrency strategy: two actors racing to check
// out the same CadDocument both attempt `CadCheckout.create()`; the unique
// index lets exactly one succeed, and the loser's insert fails with a
// unique-constraint violation, which the application layer turns into
// either an idempotent "you already hold it" response (same actor) or a 409
// conflict naming the other actor (different actor). No row-locking
// transaction is required - the unique index IS the serialization point.
//
// A future check-in milestone can DELETE this row on check-in (the
// constraint keeps working unmodified), or, if checkout HISTORY must be
// preserved, replace this with a closedAt column and a partial unique index
// (WHERE "closedAt" IS NULL) instead - deliberately NOT decided here.
// ============================================================

model CadCheckout {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Composite tenant-aware FK: a checkout can only ever target a CadDocument
  // in the SAME organization. Together with the unique constraint below, at
  // most one checkout can ever exist for a given (organizationId,
  // cadDocumentId) pair.
  cadDocumentId String
  cadDocument   CadDocument @relation(fields: [organizationId, cadDocumentId], references: [organizationId, id], onDelete: Cascade)

  // The exact FileVersion that was the newest binary-backed version at the
  // moment checkout began. Never re-resolved afterward - uploading a newer
  // FileVersion does NOT change this row. Restrict (not cascade): a
  // FileVersion is immutable and must not silently disappear out from under
  // an active lock.
  baseFileVersionId String
  baseFileVersion   FileVersion @relation(fields: [organizationId, baseFileVersionId], references: [organizationId, id], onDelete: Restrict)

  // Set from the authenticated actor on the server, never from the client.
  checkedOutById String
  checkedOutBy   User   @relation(fields: [organizationId, checkedOutById], references: [organizationId, id], onDelete: Restrict)

  checkedOutAt DateTime @default(now())

  // Optional free-text note from the actor at checkout time (e.g. "fixing
  // the mount hole pattern"). Never required, never interpreted by the server.
  note String?

  @@unique([organizationId, id])
  // At most one checkout per CadDocument - see the model comment above.
  @@unique([organizationId, cadDocumentId])
  @@index([organizationId])
  @@index([baseFileVersionId])
  @@index([checkedOutById])
}

// ============================================================
// CAD CHECKOUT EVENT  (P3C-3 - durable checkout lifecycle history)
//
// CadCheckout rows are DELETED the instant a checkout is consumed
// (Check-In) or released (Undo Checkout, Admin Unlock) - see CadCheckout's
// own doc comment. Without a separate durable record, that deletion would
// silently erase who held a document, when, and why it was released. This
// model is that minimal, forward-compatible, append-only history - NOT a
// generic enterprise audit framework: it records exactly the four
// checkout-lifecycle events (CHECKED_OUT, CHECKED_IN, UNDO_CHECKOUT,
// ADMIN_UNLOCK) and nothing else.
//
// `checkoutId` is DELIBERATELY NOT a foreign key. The CadCheckout row it
// names is deleted in the SAME transaction that inserts this event (for
// every event type except CHECKED_OUT), so there is nothing durable left to
// reference once the transaction commits - a Restrict FK would make that
// delete impossible, and a Cascade FK would delete the very event meant to
// survive it. It is recorded as a plain historical identifier only.
//
// IDENTITY, NOT DISPLAY DATA: `checkoutOwnerId` / `actedById` are User IDs,
// never names or emails - a name is mutable display data, not a stable
// historical identity. A caller that needs a display name joins it
// separately, scoped to its own tenant, at read time.
//
// FK / DELETE STRATEGY (deliberate, not the schema-wide default): every
// live FK below (cadDocumentId, baseFileVersionId, checkoutOwnerId,
// actedById) uses onDelete: Restrict, NEVER Cascade - even though
// CadCheckout's OWN cadDocumentId FK cascades. History must OUTLIVE the
// records it is about: if a CadDocument or User were ever deleted (no such
// path exists anywhere in this app today), Restrict means that delete is
// refused while checkout history still names it, rather than silently
// erasing the audit trail. FileVersion rows are immutable and never
// deleted in this schema, so Restrict there is a safety net, not a live
// constraint. Widening any of these to Cascade later must be a deliberate,
// audited decision - not a side effect of an unrelated schema change.
// ============================================================

model CadCheckoutEvent {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Composite tenant-aware FK, Restrict (not Cascade) - see the model
  // comment above.
  cadDocumentId String
  cadDocument   CadDocument @relation(fields: [organizationId, cadDocumentId], references: [organizationId, id], onDelete: Restrict)

  // Historical identifier only - NOT a foreign key. See the model comment.
  checkoutId String

  // The FileVersion the checkout was based on. FileVersions are immutable
  // and never deleted, so this stays resolvable in practice; Restrict
  // regardless, matching CadCheckout.baseFileVersionId's own reasoning.
  baseFileVersionId String
  baseFileVersion   FileVersion @relation(fields: [organizationId, baseFileVersionId], references: [organizationId, id], onDelete: Restrict)

  // Who HELD the checkout (copied from CadCheckout.checkedOutById at the
  // moment of the event - the checkout row itself is about to be deleted).
  checkoutOwnerId String
  checkoutOwner   User   @relation("CadCheckoutEventOwner", fields: [organizationId, checkoutOwnerId], references: [organizationId, id], onDelete: Restrict)

  // Who PERFORMED this event. Equal to checkoutOwnerId for CHECKED_OUT /
  // CHECKED_IN / UNDO_CHECKOUT (an actor only ever consumes/releases their
  // OWN checkout there); DIFFERS for ADMIN_UNLOCK (the acting admin, not
  // the checkout's owner).
  actedById String
  actedBy   User   @relation("CadCheckoutEventActor", fields: [organizationId, actedById], references: [organizationId, id], onDelete: Restrict)

  eventType CadCheckoutEventType

  // When the ORIGINAL checkout began (copied from CadCheckout.checkedOutAt) -
  // preserved because the live checkout row is gone.
  checkedOutAt DateTime

  // When THIS event happened.
  occurredAt DateTime @default(now())

  // Optional for UNDO_CHECKOUT, required by application logic (not a DB
  // constraint - see app/lib/checkout-release-core.ts) for ADMIN_UNLOCK.
  // Bounded length, trimmed, control characters stripped before storage -
  // never a place for secrets or system data.
  reason String?

  @@index([organizationId, cadDocumentId, occurredAt])
  @@index([organizationId, checkoutOwnerId])
  @@index([organizationId, actedById])
}

// ============================================================
// RELEASE BASELINE  (P3D-1 - frozen engineering release snapshot)
//
// When an ItemRevision transitions to RELEASED, this permanently captures
// the EXACT CAD FileVersion that constituted that release for each
// DIRECTLY associated CadDocument (ItemRevisionDocument links only - the
// full CadDependency graph closure is explicitly OUT of scope here; see
// ReleaseBaselineEntry). A later FileVersion on the same CadDocument (a
// direct upload, or a NEW check-in after further checkout/edit) never
// moves this baseline - it is evidence of what the release WAS, not a live
// view of the document's current state (that remains
// ItemRevisionDocument's job - see that model's own doc comment).
//
// ONE baseline per ItemRevision: `@@unique([organizationId,
// itemRevisionId])` is deliberately the SAME "optional 1:1 relation backed
// by a unique constraint" pattern as CadDocument.checkout - it is both the
// modeling choice (ItemRevision.releaseBaseline is `ReleaseBaseline?`) and
// the DB-enforced backstop for "a repeated release request must never
// create a second baseline": the application layer already refuses this
// (advanceRevisionForActor's terminal-lifecycle guard rejects any lifecycle
// change, including a second RELEASED transition, on a revision that is
// already RELEASED/terminal - see app/lib/release-db.ts), so this
// constraint should never actually fire in normal operation, but it is the
// database's own proof that it cannot, regardless of what future
// application code does.
//
// IMMUTABILITY (P3D-1, application-level + strong DB constraints - no
// admin override, no update/delete path exposed anywhere):
//   - no route/action ever calls .update() or .delete() on ReleaseBaseline
//     or ReleaseBaselineEntry;
//   - onDelete: Restrict on itemRevisionId / createdById (see below) means
//     the evidence this row represents cannot be silently erased by
//     deleting the ItemRevision or User it names, even though no such
//     delete path exists anywhere in this app today - if one is ever
//     added, it must reckon with released evidence deliberately, not by
//     accident.
//
// AUDIT, NOT A GENERIC FRAMEWORK: only createdById + createdAt are
// captured. No broader audit-event model is introduced here - see
// CadCheckoutEvent for the (separate, already-existing) checkout-history
// mechanism, which this deliberately does not duplicate or extend.
// ============================================================

model ReleaseBaseline {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Composite tenant-aware FK, Restrict (not Cascade) - released evidence
  // must outlive the revision record if that record is ever deletable in
  // the future (no such path exists today).
  itemRevisionId String
  itemRevision   ItemRevision @relation(fields: [organizationId, itemRevisionId], references: [organizationId, id], onDelete: Restrict)

  // Set from the authenticated actor on the server, never from the client.
  // Restrict - the same "evidence must outlive the User it names" reasoning
  // used throughout (CadCheckoutEvent, etc).
  createdById String
  createdBy   User   @relation(fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict)

  createdAt DateTime @default(now())

  entries ReleaseBaselineEntry[]

  @@unique([organizationId, id])
  // At most one baseline per revision - see the model comment above.
  @@unique([organizationId, itemRevisionId])
  @@index([organizationId])
  @@index([createdById])
}

// ============================================================
// RELEASE BASELINE ENTRY  (P3D-1, extended P3D-3)
//
// One pinned (CadDocument, FileVersion) pair per CadDocument in the release's
// dependency-complete closure at the moment of release:
//   - every CadDocument DIRECTLY associated with the ItemRevision via
//     ItemRevisionDocument (inclusionKind = DIRECT), AND
//   - every CadDocument reachable from those via the outgoing CadDependency
//     closure - parentDocumentId -> childDocumentId, recursively
//     (inclusionKind = DEPENDENCY).
// Exactly one entry per CadDocument per baseline (a document reached both
// ways is stored once, as DIRECT). P3D-1 baselines predate the closure walk
// and contain DIRECT entries only; `inclusionKind` defaults to DIRECT so
// those historical rows read back truthfully and are never re-expanded using
// today's graph.
//
// KEY CONSTRAINT - proving fileVersionId actually belongs to cadDocumentId:
// a naive `fileVersionId -> FileVersion(organizationId, id)` FK only proves
// the FileVersion exists in the SAME organization - nothing stops a caller
// (or a bug) from pairing cadDocumentId=Assembly.iam with a fileVersionId
// that actually belongs to Frame.ipt. Instead, this FK is the COMPOSITE
// (organizationId, cadDocumentId, fileVersionId), referencing FileVersion's
// (organizationId, cadDocumentId, id) unique constraint (added in P3D-1
// specifically to make this possible). Because FileVersion's OWN
// cadDocumentId is part of that referenced key, the database itself proves
// the pinned FileVersion belongs to the pinned CadDocument - a mismatched
// pair is a foreign-key violation, not just an application-level bug that
// could slip through.
//
// Deliberately does NOT store originalFileName / any display data:
// "released snapshot identity must not depend on filename" - the pinned
// identity is (cadDocumentId, fileVersionId) only. A caller needing display
// data joins CadDocument / FileVersion at read time.
//
// FK strategy: cadDocumentId and the FileVersion composite FK both use
// Restrict (never Cascade) - the SAME "evidence must outlive the thing it
// names" reasoning as ReleaseBaseline itself; releaseBaselineId uses
// Cascade because an entry has no independent meaning once its OWNING
// baseline is gone (P3D-1 exposes no delete path for ReleaseBaseline at
// all, so this never actually fires - it exists only for referential
// consistency if a baseline were ever administratively removed later).
// ============================================================

model ReleaseBaselineEntry {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  releaseBaselineId String
  releaseBaseline   ReleaseBaseline @relation(fields: [organizationId, releaseBaselineId], references: [organizationId, id], onDelete: Cascade)

  cadDocumentId String
  cadDocument   CadDocument @relation(fields: [organizationId, cadDocumentId], references: [organizationId, id], onDelete: Restrict)

  // Composite FK proving fileVersionId belongs to cadDocumentId - see the
  // model comment above. NOT a plain (organizationId, id) reference.
  fileVersionId String
  fileVersion   FileVersion @relation(fields: [organizationId, cadDocumentId, fileVersionId], references: [organizationId, cadDocumentId, id], onDelete: Restrict)

  // P3D-3: whether this document was directly associated with the revision or
  // pulled in through the CadDependency closure. Additive; DIRECT default
  // backfills existing P3D-1 entries, which were all direct.
  inclusionKind ReleaseBaselineInclusionKind @default(DIRECT)

  createdAt DateTime @default(now())

  @@unique([organizationId, id])
  // One entry per CadDocument per baseline.
  @@unique([releaseBaselineId, cadDocumentId])
  @@index([organizationId])
  @@index([releaseBaselineId])
  @@index([cadDocumentId])
  @@index([fileVersionId])
}

// ============================================================
// DESKTOP SESSION  (P4A - Inventor CAD Connect foundation)
//
// A server-issued bearer session for a NON-browser client (the Autodesk
// Inventor "Arch Engineering" CAD Connect add-in). The browser dashboard
// keeps using NextAuth cookies unchanged; this table exists ONLY so a
// desktop client has a first-class, server-revocable session that does not
// depend on NextAuth's CSRF/cookie internals.
//
// SECURITY MODEL
//   - The raw token is a 256-bit random string returned to the client ONCE,
//     at creation. Only its SHA-256 hash is stored here - a database leak
//     never yields a usable token.
//   - organizationId / userId are derived on the server from verified
//     credentials at creation and are the ONLY tenant source of truth for
//     any request this session authenticates. A desktop client can never
//     supply or influence them.
//   - `expiresAt` is enforced on every request. `revokedAt` is set by an
//     explicit sign-out (or future admin action) and makes the token
//     immediately unusable - this is what "logout invalidates the session"
//     means server-side.
//   - No password is stored here or anywhere on the client.
// ============================================================

model DesktopSession {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Tenant-aware composite FK: a session can only ever name a user in its
  // own organization.
  userId String
  user   User   @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Cascade)

  // SHA-256 (lowercase hex) of the opaque bearer token. Unique so a lookup
  // by token hash is a single indexed point read. The raw token is never
  // persisted.
  tokenHash String @unique

  // Free-text, client-supplied, NON-authoritative label shown back to the
  // user when listing their sessions ("Inventor 2025 on WORKSTATION-01").
  // Never used for any security decision.
  clientLabel String?

  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([organizationId])
  @@index([userId])
  @@index([expiresAt])
}

// ============================================================
// COPY DESIGN OPERATION + LINEAGE  (P6B - PLM identity reservation)
//
// Establishes the server-side stable identities and immutable lineage a
// confirmed Arch CAD Connect P6A "Copy Design" plan needs BEFORE any
// physical Inventor file operation (P6C). This is IDENTITY-ONLY:
//   - creates NO binary data, NO FileVersion, NO ItemRevision;
//   - never touches Inventor, never SaveAs, never replaces a reference;
//   - never copies a source document's FileVersion history, engineering
//     revisions, checkout/check-in history, audit history, or release
//     baselines - the new CadDocument simply starts with none of its own,
//     and every row belonging to the source is completely untouched.
//
// COPY vs REUSE (enforced in app/lib/copy-design-lineage-db.ts, not here):
//   - COPY creates a brand-new CadDocument (a fresh cuid - NEVER the source's
//     id) plus EXACTLY ONE CadCopyLineage row naming its exact source
//     CadDocument + source FileVersion.
//   - REUSE creates NOTHING: the existing CadDocument identity is validated
//     (tenant-scoped) and returned as-is. A REUSE entry never produces a
//     CadCopyLineage row - a lineage row existing at all always means "this
//     identity IS a copy"; there is deliberately no other reason for one to
//     exist.
//
// RESERVED IDENTITY STATE - NO NEW COLUMN: a COPY's new CadDocument is a
// real, live identity the instant it is created, but has not yet been
// physically materialized by P6C (no FileVersion exists for it yet).
// Distinguishing "reserved, awaiting P6C" from "physically materialized"
// needs NO new state column or workflow: it is simply
//   materialized  <=>  CadDocument.fileVersions is non-empty
// A CadDocument created through the ordinary (non-copy) createCadDocument
// action already starts with zero FileVersions too, so "has no FileVersion
// yet" is not unique to Copy Design - what IS unique to a copy is the
// existence of a `copyLineageAsNew` row. The two facts are independent and
// both already directly queryable, so "a Copy Design identity reserved for
// later materialization" is simply the conjunction
//   copyLineageAsNew IS NOT NULL  AND  fileVersions IS EMPTY
// The moment P6C creates that CadDocument's first FileVersion - which it
// must do anyway to perform its job - this conjunction becomes false
// automatically. There is no separate "mark as materialized" step to run,
// forget, or get out of sync: the transition is implicit in P6C's own normal
// FileVersion-creation write, using the EXACT SAME code path
// (`storeCadFileVersionForActor`) every other FileVersion creation already
// uses.
// ============================================================

model CopyDesignOperation {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Client-generated OPAQUE idempotency token (e.g. a UUID minted by CAD
  // Connect when the engineer confirms the plan). NEVER derived from a
  // filename, path, source/destination rename token, or document number -
  // those are plan CONTENT, not operation identity. Retrying the apply call
  // with the SAME key and an equivalent request resolves to this SAME row
  // and creates nothing new; the SAME key with a materially different
  // request is rejected (see copy-design-lineage-core.ts).
  idempotencyKey String

  // Set from the authenticated actor on the server, never from the client.
  performedById String
  performedBy   User   @relation(fields: [organizationId, performedById], references: [organizationId, id], onDelete: Restrict)

  performedAt DateTime @default(now())

  // Optional, display-only, client-supplied label (e.g. "10073 -> 10137").
  // Never identity, never interpreted by any lineage/idempotency logic.
  label String?

  // The EXACT normalized request this operation was applied for. Used ONLY
  // to detect and reject a retry that reuses this SAME idempotencyKey with a
  // materially different request (see copyDesignPayloadsEqual in
  // copy-design-lineage-core.ts) - NEVER used to reconstruct the response
  // (see CopyDesignOperationEntry below for that).
  requestPayload Json

  // CadCopyLineage evidence rows this operation produced (COPY entries
  // only - see CadCopyLineage's own doc comment). NOT consulted for replay.
  lineageEntries CadCopyLineage[]

  // ROUND 2, HIGH: the COMPLETE, ordered, IMMUTABLE record of every entry
  // (COPY *and* REUSE) this operation decided, one row per request entry,
  // in stable `ordinal` order. This - and ONLY this - is what an idempotent
  // retry's response is reconstructed from; see CopyDesignOperationEntry's
  // own doc comment for why.
  entries CopyDesignOperationEntry[]

  @@unique([organizationId, id])
  // The entire idempotency mechanism: retrying the SAME operation must
  // resolve to the SAME row, never create a second one.
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([performedById])
}

model CadCopyLineage {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // REQUIRED - every lineage row belongs to exactly one Copy Design
  // operation; operation association is never optional. Restrict (not
  // Cascade) - the same "evidence must outlive the record it names" rule
  // used throughout this schema (CadCheckoutEvent, ReleaseBaseline, etc.) -
  // even though no delete path for CopyDesignOperation exists today.
  copyDesignOperationId String
  copyDesignOperation   CopyDesignOperation @relation(fields: [organizationId, copyDesignOperationId], references: [organizationId, id], onDelete: Restrict)

  // The NEW identity this row is about. UNIQUE (see @@unique below): a
  // CadDocument can be "a copy" at most once, and - because no update/delete
  // API is ever exposed for this row - can never be reassigned to a
  // different source through any API once created.
  newCadDocumentId String
  newCadDocument   CadDocument @relation("CadCopyLineageNew", fields: [organizationId, newCadDocumentId], references: [organizationId, id], onDelete: Restrict)

  // The source identity copied FROM. Restrict - lineage must outlive the
  // source document even if it were ever deletable in the future (no such
  // path exists today).
  sourceCadDocumentId String
  sourceCadDocument   CadDocument @relation("CadCopyLineageSource", fields: [organizationId, sourceCadDocumentId], references: [organizationId, id], onDelete: Restrict)

  // KEY CONSTRAINT - proving sourceFileVersionId actually belongs to
  // sourceCadDocumentId: the SAME technique as ReleaseBaselineEntry.fileVersion
  // (see that model's own doc comment for the full reasoning). This FK is
  // the COMPOSITE (organizationId, sourceCadDocumentId, sourceFileVersionId),
  // referencing FileVersion's (organizationId, cadDocumentId, id) unique
  // constraint - because FileVersion's OWN cadDocumentId is part of that
  // referenced key, the database itself proves the pinned FileVersion
  // belongs to the pinned source CadDocument; a mismatched pair is a
  // foreign-key violation, not just an application-level bug that could
  // slip through. Restrict - the exact version copied from must remain
  // resolvable for as long as this lineage row exists (FileVersions are
  // immutable and never deleted in this schema regardless).
  sourceFileVersionId String
  sourceFileVersion   FileVersion @relation(fields: [organizationId, sourceCadDocumentId, sourceFileVersionId], references: [organizationId, cadDocumentId, id], onDelete: Restrict)

  // Set from the authenticated actor on the server, never from the client.
  copiedById String
  copiedBy   User   @relation(fields: [organizationId, copiedById], references: [organizationId, id], onDelete: Restrict)

  copiedAt DateTime @default(now())

  @@unique([organizationId, id])
  // Backs the composite FK above (Prisma requires the referenced side of a
  // to-one relation to be a unique key) - equivalent to the plain
  // `newCadDocumentId @unique` already declared: no CadDocument can be named
  // as "new" by more than one lineage row.
  @@unique([organizationId, newCadDocumentId])
  @@index([organizationId])
  @@index([copyDesignOperationId])
  @@index([sourceCadDocumentId])
  @@index([copiedById])
}

// ============================================================
// COPY DESIGN OPERATION ENTRY  (P6B Round 2, HIGH - immutable replay record)
//
// PROBLEM THIS FIXES: an idempotent retry must reconstruct the EXACT
// original response. The first P6B cut correlated a retry's COPY entries
// against the CURRENT `CadDocument.documentNumber` - but `documentNumber` is
// MUTABLE (nothing prevents a later rename). If two documents created by the
// SAME operation are later renamed (independently, or swapped with each
// other), that correlation could return the WRONG resultingCadDocumentId, a
// spurious 404, or a mismatched entry set - silently breaking the promise
// that a replay reflects what THIS operation actually did.
//
// FIX: one row per REQUEST ENTRY (COPY *and* REUSE), written in the SAME
// transaction as the operation itself, carrying:
//   - a stable `ordinal` (the entry's position in the ORIGINAL request array
//     - assigned once, at creation, NEVER recomputed) - the sole correlation
//     key between a stored entry and the response position it belongs to;
//   - `resultingCadDocumentId` - the ACTUAL identity this entry resolved to
//     (the new CadDocument for COPY, the existing one for REUSE) - a stable
//     id, immutable once written;
//   - an immutable SNAPSHOT of the display fields (`originalDocumentNumber`
//     / `originalFileName` / `originalDocumentType` / `originalDescription`)
//     AS THEY WERE the moment this entry was decided - NEVER re-read from
//     CURRENT (mutable) CadDocument state on replay, for COPY OR REUSE.
//
// A replay reads ONLY this table (ordered by `ordinal`) plus the stable ids
// it names - it never queries CadDocument's current fields, and never
// depends on documentNumber, fileName, or any other mutable property to
// figure out which stored row corresponds to which original request entry.
//
// RELATIONSHIP TO CadCopyLineage: CadCopyLineage remains the append-only
// COPY-specific lineage/audit evidence (source CadDocument + exact source
// FileVersion a new identity came from) - unchanged by this addition. This
// table is a SEPARATE concern: complete operation/result REPLAY, covering
// REUSE entries too (which CadCopyLineage deliberately never records - see
// its own doc comment). No update/delete API is ever exposed for either.
// ============================================================

model CopyDesignOperationEntry {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // REQUIRED - every entry belongs to exactly one operation. Restrict - the
  // same "evidence must outlive the record it names" rule used throughout.
  copyDesignOperationId String
  copyDesignOperation   CopyDesignOperation @relation(fields: [organizationId, copyDesignOperationId], references: [organizationId, id], onDelete: Restrict)

  // This entry's position in the ORIGINAL request's `entries` array.
  // Assigned once, at creation, from array index - NEVER recomputed, NEVER
  // reordered. The sole stable correlation key for replay.
  ordinal Int

  action CopyDesignEntryAction

  // COPY only: the source identity copied FROM. Null for REUSE (a REUSE
  // entry has no "copied from" relationship at all - its only identity IS
  // resultingCadDocumentId). Restrict - evidence must outlive the document
  // it names.
  sourceCadDocumentId String?
  sourceCadDocument   CadDocument? @relation("CopyDesignOperationEntrySource", fields: [organizationId, sourceCadDocumentId], references: [organizationId, id], onDelete: Restrict, map: "CopyDesignOperationEntry_sourceCadDocument_fkey")

  // COPY only: the EXACT source FileVersion, proven (via the composite FK
  // below) to belong to sourceCadDocumentId - the SAME technique as
  // CadCopyLineage.sourceFileVersion. Null for REUSE. A composite FK with a
  // nullable member is satisfied (never checked) whenever either column is
  // NULL, so this stays valid for REUSE rows while still being fully
  // enforced whenever a COPY row supplies both.
  //
  // NOTE: explicit `map` names on this and sourceCadDocument's FK above -
  // without them Prisma's auto-generated (truncated) constraint names
  // collide for this model (its name is long enough that both FKs' names
  // truncate to the same prefix).
  sourceFileVersionId String?
  sourceFileVersion   FileVersion? @relation(fields: [organizationId, sourceCadDocumentId, sourceFileVersionId], references: [organizationId, cadDocumentId, id], onDelete: Restrict, map: "CopyDesignOperationEntry_sourceFileVersion_fkey")

  // P6B Round 3: a PostgreSQL CHECK constraint
  // ("CopyDesignOperationEntry_source_shape_matches_action", added by hand
  // in migration 20260916200612_add_copy_design_operation_entry_source_shape_check
  // - Prisma's schema DSL cannot express CHECK constraints, exactly like
  // CadDependency_no_self_reference) additionally enforces that
  // sourceCadDocumentId/sourceFileVersionId are BOTH non-null for action =
  // COPY and BOTH null for action = REUSE. The composite FK above only
  // proves a *non-null* pair belongs together - it does not by itself
  // forbid a null/non-null mismatch, which is exactly the invalid state
  // this CHECK closes off at the database level.

  // ALWAYS required: COPY -> the newly-created CadDocument; REUSE -> the
  // existing reused CadDocument. Restrict - evidence must outlive the
  // document it names.
  resultingCadDocumentId String
  resultingCadDocument   CadDocument @relation("CopyDesignOperationEntryResult", fields: [organizationId, resultingCadDocumentId], references: [organizationId, id], onDelete: Restrict)

  // IMMUTABLE SNAPSHOT of resultingCadDocument's display fields AT THE TIME
  // this entry was decided - NEVER re-read from CURRENT CadDocument state.
  // This is what makes replay safe against a later rename of either the
  // source or the resulting document.
  originalDocumentNumber String
  originalFileName       String
  originalDocumentType   CadDocumentType
  originalDescription    String?

  createdAt DateTime @default(now())

  @@unique([organizationId, id])
  // One entry per position per operation - and the ordinal-uniqueness
  // backstop that makes "two entries claiming the same position" a
  // foreign-key-adjacent impossibility, not just an application convention.
  @@unique([organizationId, copyDesignOperationId, ordinal])
  @@index([organizationId])
  @@index([copyDesignOperationId])
  @@index([sourceCadDocumentId])
  @@index([resultingCadDocumentId])
}
